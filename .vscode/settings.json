{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.envFile": "${workspaceFolder}/.vscode/kora.env",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests", "-q"],
  "terminal.integrated.env.osx": { "KORA_DATA_DIR": "${workspaceFolder}/.kora-data" },
  "terminal.integrated.env.linux": { "KORA_DATA_DIR": "${workspaceFolder}/.kora-data" },
  "terminal.integrated.env.windows": { "KORA_DATA_DIR": "${workspaceFolder}\\.kora-data" },
  "files.exclude": { "**/__pycache__": true, ".pytest_cache": true, "*.egg-info": true },
  "search.exclude": { ".kora-data": true, ".venv": true, "samples": true }
}
