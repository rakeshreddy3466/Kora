# Copy to .env (scripts/docker-up.sh does this for you, with random values) and keep it private.
# Generate a key with:  python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
POSTGRES_PASSWORD=change-me
KORA_CAPSULE_SIGNING_KEY=
KORA_AUDIT_MAC_KEY=
# optional: AES-256-GCM encryption of stored blobs
KORA_BLOB_ENCRYPTION_KEY=

# the folder to process, mounted read-only at /import (in the website: Pipeline > Add a folder > /import)
KORA_IMPORT_DIR=./samples
# website port on this computer
KORA_PORT=8080
# recordings may take this long to read (seconds)
KORA_MEDIA_TIMEOUT_S=7200
KORA_LOG_LEVEL=INFO
